# Скопируйте в .env и заполните. Права: chmod 600 .env

# Ключ шифрования паролей и SSH-ключей в БД и подписи сессий (не меньше 16 символов).
# Сгенерировать: openssl rand -base64 32
# Если изменить — сохранённые пароли серверов придётся ввести заново.
APP_SECRET=

# Вход в веб-интерфейс
ADMIN_USER=admin
ADMIN_PASSWORD=

# Токен для /api/status (мониторинг, Zabbix). Пусто — только после входа в интерфейс.
STATUS_TOKEN=

# 1 — cookie только по HTTPS (если интерфейс открыт через обратный прокси с TLS)
COOKIE_SECURE=0

TZ=Asia/Yekaterinburg
